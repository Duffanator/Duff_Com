# Build & distribution output directories (regenerated by build_and_run.bat / CMake)
/build/
/dist/

# Local DOS toolchain / DOSBox-X bundle (if installed locally in workspace)
/.dos/

# Compiled binaries & intermediate C / DJGPP / GCC artifacts
*.exe
*.EXE
*.o
*.obj
*.i
*.ii
*.s
*.out
*.map
*.sym
*.d
*.a
*.lib

# CMake, Ninja & local Clangd index/config files
/CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
build.ninja
.ninja_deps
.ninja_log
compile_commands.json
compile_flags.txt
/.cache/

# Ignore unpacked third-party VS Code extension files in tools/,
# keeping only DUFF-COM's own sprite & sound generator scripts/sources
/tools/*
!/tools/gen_sfx.ps1
!/tools/gen_sprites.ps1
!/tools/portraits_male_src.jpg
!/tools/portraits_female_src.jpg

# Runtime screenshots & DOSBox-X logs / captures
/SNAP.BMP
/snap.bmp
dosbox-x.log
stdout.txt
stderr.txt
mapper-*.map
/capture/

# OS & editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
/.vs/
